# StackBraid — environment variables.
#
# This file names every variable infra/compose.yaml reads. None are filled
# in — copy this file to .env and set your own values before running
# anything you don't want left at compose.yaml's built-in development
# defaults. .env is gitignored; never commit real values.
#
#   cp .env.example .env
#
# `docker compose -f infra/compose.yaml up -d` also works with no .env file
# at all — every variable below falls back to a working (but insecure,
# development-only) default baked into infra/compose.yaml.

# --- Postgres ---------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# --- RabbitMQ -----------------------------------------------------------
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_PORT=
RABBITMQ_MANAGEMENT_PORT=

# --- Redis ----------------------------------------------------------------
REDIS_PASSWORD=
REDIS_PORT=

# --- Prometheus -------------------------------------------------------
PROMETHEUS_PORT=

# --- Loki ---------------------------------------------------------------
LOKI_PORT=

# --- Grafana --------------------------------------------------------------
GRAFANA_PORT=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
