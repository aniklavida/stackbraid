# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Regenerated by `next dev`/`next build` on every run — see
# https://nextjs.org/docs/messages, "generate-agent-files". This repository
# keeps its own agent instructions at the repository root (AGENTS.md,
# CLAUDE.md, .agent/playbooks/); these are Next.js's own, unrelated files.
/AGENTS.md
/CLAUDE.md

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
